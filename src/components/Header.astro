---
---

<header class="site-header" data-header>
  <a class="brand" href="#inicio" aria-label="Avianca SeatMap Pro, ir al inicio">
    <img src="/avianca-symbol.png" alt="" width="32" height="32" class="brand-symbol" />
    <span class="brand-name">Avianca <span>SeatMap Pro</span></span>
  </a>

  <div class="route" aria-hidden="true">
    <div class="route-line">
      <span class="route-code">BOG</span>
      <span class="route-track">
        <span class="route-fill"></span>
        <span class="route-dot"></span>
      </span>
      <span class="route-code">MAD</span>
    </div>
    <p class="route-meta">AV026 · B787-8 · Insignia</p>
  </div>

  <div class="actions">
    <button type="button" class="theme-btn" data-theme-toggle aria-label="Cambiar a modo claro">
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
      </svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path>
      </svg>
    </button>
    <a class="cta" href="https://pax-list-angular.vercel.app" target="_blank" rel="noopener noreferrer">
      Abrir la demo<span class="sr-only"> (se abre en una pestaña nueva)</span>
    </a>
  </div>

  <span class="progress" aria-hidden="true"></span>
</header>

<style>
  .site-header {
    --p: 0;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    height: 64px;
    padding-inline: 16px;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 86%, transparent);
    backdrop-filter: blur(18px);
    color: var(--fg);
  }
  @media (min-width: 768px) {
    .site-header {
      padding-inline: 32px;
    }
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--fg);
    text-decoration: none;
  }
  .brand-symbol {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }
  .brand-name {
    display: none;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .brand-name span {
    color: var(--fg-2);
  }
  @media (min-width: 560px) {
    .brand-name {
      display: inline;
    }
  }

  .route {
    display: none;
    justify-self: center;
    width: min(100%, 420px);
  }
  @media (min-width: 1024px) {
    .route {
      display: grid;
      gap: 2px;
    }
  }
  .route-line {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .route-code {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .route-track {
    position: relative;
    flex: 1;
    height: 1px;
    background: var(--line-strong);
  }
  .route-fill {
    position: absolute;
    inset: 0;
    background: var(--brand-text);
    transform: scaleX(var(--p));
    transform-origin: 0 50%;
  }
  .route-dot {
    position: absolute;
    top: 50%;
    left: calc(var(--p) * 100%);
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border: 2px solid var(--brand-text);
    border-radius: 999px;
    background: var(--ink);
  }
  .route-meta {
    margin: 0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }

  .actions {
    grid-column: 3;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .theme-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--fg-2);
    cursor: pointer;
    transition:
      background-color 150ms var(--ease-out),
      transform 150ms var(--ease-out);
  }
  .theme-btn:active,
  .cta:active {
    transform: scale(0.97);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 150ms var(--ease-out),
      color 150ms var(--ease-out),
      transform 150ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .theme-btn:hover {
      background: color-mix(in srgb, var(--fg) 6%, transparent);
    }
    .cta:hover {
      background: var(--brand);
      color: #fff;
    }
  }
  .icon-moon {
    display: none;
  }
  :global(:root[data-theme='light']) .icon-sun {
    display: none;
  }
  :global(:root[data-theme='light']) .icon-moon {
    display: block;
  }

  /* En pantallas sin ruta central, el avance se lee en una línea bajo el encabezado */
  .progress {
    position: absolute;
    inset: auto 0 -1px 0;
    height: 2px;
    background: var(--brand-text);
    transform: scaleX(var(--p));
    transform-origin: 0 50%;
  }
  @media (min-width: 1024px) {
    .progress {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-btn,
    .cta {
      transition: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('[data-header]');

  function sync() {
    const light = root.getAttribute('data-theme') === 'light';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-label', light ? 'Cambiar a modo oscuro' : 'Cambiar a modo claro');
      if (btn.hasAttribute('aria-pressed')) btn.setAttribute('aria-pressed', String(light));
    });
    document.querySelectorAll<HTMLElement>('[data-theme-name]').forEach((el) => {
      el.textContent = light ? 'Claro · #f3f1ee' : 'Oscuro · #0b0c0f';
    });
  }

  document.addEventListener('click', (event) => {
    const btn = (event.target as Element | null)?.closest('[data-theme-toggle]');
    if (!btn) return;
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
  });

  let raf = 0;
  function progress() {
    raf = 0;
    const max = document.documentElement.scrollHeight - innerHeight;
    header?.style.setProperty('--p', String(max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0));
  }
  addEventListener('scroll', () => {
    if (!raf) raf = requestAnimationFrame(progress);
  }, { passive: true });
  addEventListener('resize', progress);

  sync();
  progress();
</script>
