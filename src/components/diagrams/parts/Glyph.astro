---
interface Props {
  name: 'shield' | 'key' | 'tray' | 'tower' | 'check' | 'cross' | 'equals' | 'device' | 'person';
  x: number;
  y: number;
  tone?: 'ok' | 'warn';
}

const { name, x, y, tone } = Astro.props;
---

<g transform={`translate(${x} ${y})`} class:list={['gl', { 'gl-ok': tone === 'ok', 'gl-warn': tone === 'warn' }]}>
  {
    name === 'shield' && (
      <>
        <path d="M0 -10L8 -7V0C8 5 4 8.5 0 10.5C-4 8.5 -8 5 -8 0V-7Z" />
        <circle cx="0" cy="-2" r="2" />
        <path d="M0 0V3.5" />
      </>
    )
  }
  {
    name === 'key' && (
      <>
        <circle cx="-5" cy="0" r="3.5" />
        <path d="M-1.5 0H9M6 0V3.5M9 0V3" />
      </>
    )
  }
  {
    name === 'tray' && (
      <>
        <path d="M-9 1L-6 -6H6L9 1V8H-9Z" />
        <path d="M-9 1H-3L-2 3.5H2L3 1H9" />
      </>
    )
  }
  {
    name === 'tower' && (
      <>
        <path d="M-9 14L0 -14L9 14" />
        <path d="M-5 5H5" />
        <path d="M-15 -8Q-20 0 -15 8M15 -8Q20 0 15 8" />
      </>
    )
  }
  {
    name === 'device' && (
      <>
        <rect x="-9" y="-6" width="18" height="12" rx="2.5" />
        <path d="M-3 9.5H3" />
      </>
    )
  }
  {
    name === 'person' && (
      <>
        <circle cx="0" cy="-4" r="3.5" />
        <path d="M-8 9C-8 3 -4 1 0 1C4 1 8 3 8 9" />
      </>
    )
  }
  {name === 'check' && <path d="M-4 0L-1 3.5L5 -4" />}
  {name === 'cross' && <path d="M-4 -4L4 4M4 -4L-4 4" />}
  {name === 'equals' && <path d="M-4 -2.5H4M-4 2.5H4" />}
</g>
