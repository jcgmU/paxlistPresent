---
const decisions = [
  { n: '1', t: 'Fuente del manifiesto', d: 'API del DCS de Amadeus o mensajes PNL/ADL vía SITA (A1). Destraba el adaptador y la estimación de la Fase 1.' },
  { n: '2', t: 'Vuelo piloto y tripulación', d: 'La ruta BOG–MAD, la tripulación que lo prueba y cuándo arranca, una vez aprobada la DPIA.' },
  { n: '3', t: 'Accesos e inicio de la sesión legal', d: 'Acceso a LifeMiles, Salesforce y rostering, y arranque de la sesión con Legal y el DPO (A7).' },
];
---

<section class="close" aria-labelledby="close-title">
  <div class="wrap">
    <h2 id="close-title">Probémoslo en un vuelo real.</h2>
    <p class="lead">Tres decisiones para arrancar hoy.</p>

    <ol class="decisions">
      {
        decisions.map((d) => (
          <li>
            <span class="n">{d.n}</span>
            <div>
              <h3>{d.t}</h3>
              <p>{d.d}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <a class="cta" href="https://pax-list-angular.vercel.app" target="_blank" rel="noopener noreferrer">
      Abrir la demo
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
      <span class="sr-only">(se abre en una pestaña nueva)</span>
    </a>

    <p class="legal">
      La demo usa datos de ejemplo. El backend y el modo sin conexión están diseñados, no implementados.
    </p>
  </div>
</section>

<style>
  .close {
    padding: clamp(80px, 14vh, 160px) 16px clamp(64px, 10vh, 120px);
    background: var(--ink);
    color: var(--fg);
  }
  .wrap {
    margin: 0 auto;
    max-width: 1100px;
  }
  .eyebrow {
    margin: 0 0 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  h2 {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-size: clamp(40px, 6.4vw, 96px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .lead {
    margin: 0 0 48px;
    font-size: clamp(16px, 1.3vw, 19px);
    color: var(--fg-2);
  }
  .decisions {
    display: grid;
    gap: 0;
    margin: 0 0 56px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .decisions li {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .n {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 500;
    line-height: 1;
    color: var(--brand-text);
  }
  h3 {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 500;
  }
  .decisions p {
    margin: 0;
    max-width: 60ch;
    font-size: 16px;
    line-height: 1.55;
    color: var(--fg-2);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 28px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--ink);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 150ms var(--ease-out),
      color 150ms var(--ease-out),
      transform 150ms var(--ease-out);
  }
  .cta:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .cta:hover {
      background: var(--brand);
      color: #fff;
    }
  }
  .legal {
    margin: 32px 0 0;
    max-width: 60ch;
    font-size: 13px;
    line-height: 1.5;
    color: var(--fg-3);
  }
  @media (prefers-reduced-motion: reduce) {
    .cta {
      transition: none;
    }
  }
</style>
