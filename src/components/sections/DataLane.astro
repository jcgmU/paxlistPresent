---
import DiagramEmbark from '../diagrams/DiagramEmbark.astro';
import DiagramFlightOffline from '../diagrams/DiagramFlightOffline.astro';
import DiagramLandingReconcile from '../diagrams/DiagramLandingReconcile.astro';
import DiagramSecurity from '../diagrams/DiagramSecurity.astro';

type Act = {
  id: string;
  n: string;
  kicker: string;
  title: string;
  lead: string;
  tags: { t: string; warn?: boolean }[];
  details: [string, string][];
  note?: [string, string];
};

const acts: Act[] = [
  {
    id: 'acto-v',
    n: 'Acto V',
    kicker: 'En tierra, con conexión',
    title: 'En tierra, seis sistemas consolidados y stock en tiempo real.',
    lead: 'Durante la ventana de 10 a 15 minutos en plataforma, cada iPad descarga el vuelo completo en un paquete de menos de 200 KB. Mientras hay conexión, el inventario de platos se mantiene sincronizado en vivo entre las tablets.',
    tags: [{ t: 'Diseñado' }, { t: 'Por confirmar: A1', warn: true }],
    details: [
      ['ManifestAggregatorService', 'Consulta en paralelo el DCS, el GDS, LifeMiles, Salesforce, catering y el roster, y combina sus respuestas en un solo manifiesto por vuelo.'],
      ['Circuit Breaker por adaptador', 'Si una fuente falla, su breaker se abre y el BFF entrega una respuesta parcial en lugar de bloquearse.'],
      ['Caché en PostgreSQL', 'Una consulta por vuelo a los sistemas legacy, guardada por vuelo y fecha. Las tablets leen la caché, no los sistemas de origen.'],
      ['Delta Sync con Brotli', 'Descarga incremental con un contador por vuelo y marcas de borrado para quien no aborda. Paquete menor a 200 KB, sin fotos.'],
    ],
    note: ['A1', 'Bloqueante: cómo llega el manifiesto. API del DCS de Amadeus o mensajes PNL/ADL vía SITA. Define el adaptador y la estimación de la Fase 1.'],
  },
  {
    id: 'acto-vi',
    n: 'Acto VI',
    kicker: 'En vuelo, sin red',
    title: 'Diez horas sin internet. La operación continúa intacta.',
    lead: 'Cada iPad trabaja con su propia copia cifrada del vuelo, por zona de cabina. Las comandas y los cierres de alertas NPS se guardan localmente en una cola de salida hasta aterrizar.',
    tags: [{ t: 'Diseñado' }],
    details: [
      ['@capacitor-community/sqlite + SQLCipher', 'Base de datos nativa y cifrada en el iPad, con la llave en el Keychain. El patrón es descargar, operar en local y subir al aterrizar.'],
      ['Flight Session Token offline', 'JWT firmado, válido hasta la hora estimada de llegada más 6 horas, que la app valida sin red con la clave pública embebida. Cada acción queda atada a crewMemberId.'],
      ['Transactional Outbox por zona', 'Purser, pasillo A–D y pasillo E–K escriben cada cambio en su cola local junto con el dato, para subirlo en tierra.'],
    ],
    note: [
      'P2P',
      'Nota de arquitectura: la sincronización entre iPads en vuelo (Multipeer con relojes HLC y CRDT) está diseñada en ARQUITECTURA_V3.md como fase evolutiva opcional. Se prioriza salir a producción sin depender de la red del avión (A4 y A5 por confirmar).',
    ],
  },
  {
    id: 'acto-vii',
    n: 'Acto VII',
    kicker: 'Al aterrizar y recuperar señal',
    title: 'Al aterrizar y recuperar señal, todo cuadra.',
    lead: 'Al encender los iPads con red en destino, cada uno vacía su Outbox. Si tres envían la misma comanda, queda un solo registro. Lo conciliado sale a Catering y a Salesforce, y el iPad borra los datos del vuelo.',
    tags: [{ t: 'Diseñado' }, { t: 'Por confirmar: A3', warn: true }],
    details: [
      ['Transactional Outbox', 'Cada iPad sube solo lo que originó, contra POST /sync/reconcile, que responde por transacción: aceptada, duplicada o rechazada.'],
      ['Idempotencia en dos niveles', 'transactionId evita reprocesar un envío ante reintentos HTTP. entityId identifica el hecho de negocio: tres recibidos convergen en un registro.'],
      ['sync_dead_letter', 'Lo que falla la validación o agota los reintentos queda apartado para revisión, sin perderse.'],
    ],
    note: ['A3', 'Por definir: el proceso de cierre de casos NPS en Salesforce, que habilita el envío de los casos atendidos al CRM.'],
  },
  {
    id: 'acto-viii',
    n: 'Acto VIII',
    kicker: 'Confianza y privacidad',
    title: 'Datos de salud y de viajeros, tratados como lo que son.',
    lead: 'Cuatro capas, de afuera hacia adentro: solo iPads corporativos, una tripulante autenticada, un vuelo vigente y datos cifrados que se borran al terminar.',
    tags: [{ t: 'Diseñado' }, { t: 'Por confirmar: A6', warn: true }, { t: 'Gate legal: A7, DPIA BOG–MAD', warn: true }],
    details: [],
  },
];
---

<div class="lane-fade" aria-hidden="true"></div>
<section class="lane scope-dark" aria-labelledby="lane-title">
  <div class="wrap">
    <header class="lane-head">
      <h2 id="lane-title">El mismo vuelo, visto desde el dato.</h2>
      <p class="lead">
        Lo que sigue está diseñado, no implementado. Cada pieza dice su estado y lo que falta por confirmar.
      </p>
    </header>

    {
      acts.map((a) => (
        <article class="act" id={a.id} aria-labelledby={`${a.id}-t`}>
          <header>
            <h3 id={`${a.id}-t`}>{a.title}</h3>
            <p class="act-k">{a.n} · {a.kicker}</p>
            <p class="lead">{a.lead}</p>
            <p class="tags">
              {a.tags.map((t) => (
                <span class:list={['status', t.warn ? 'status-warn' : '']}>{t.t}</span>
              ))}
            </p>
          </header>

          {a.id === 'acto-v' && <DiagramEmbark />}
          {a.id === 'acto-vi' && <DiagramFlightOffline />}
          {a.id === 'acto-vii' && <DiagramLandingReconcile />}
          {a.id === 'acto-viii' && <DiagramSecurity />}

          {a.details.length > 0 && (
            <details class="ti">
              <summary>
                <span>Detalle para TI</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
              </summary>
              <dl>
                {a.details.map(([t, d]) => (
                  <div>
                    <dt>{t}</dt>
                    <dd>{d}</dd>
                  </div>
                ))}
              </dl>
              {a.note && (
                <p class="blocker">
                  <strong>{a.note[0]}</strong>
                  {a.note[1]}
                </p>
              )}
            </details>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .lane-fade {
    height: 160px;
    background: linear-gradient(to bottom, var(--ink), #0b0c0f);
  }
  .lane {
    padding: 0 16px clamp(72px, 12vh, 140px);
  }
  .wrap {
    margin: 0 auto;
    max-width: 1240px;
  }
  .lane-head {
    margin-bottom: clamp(64px, 10vh, 120px);
    max-width: 760px;
  }
  h2 {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 72px);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  h3 {
    margin: 0 0 12px;
    max-width: 26ch;
    font-family: var(--font-display);
    font-size: clamp(28px, 3.4vw, 48px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }
  .act-k {
    margin: 0 0 16px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .lead {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.55;
    color: var(--fg-2);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 20px 0 0;
  }
  .act {
    margin-bottom: clamp(96px, 14vh, 160px);
  }
  .act header {
    margin-bottom: 40px;
  }

  .ti {
    margin-top: 32px;
    border-top: 1px solid var(--line);
  }
  .ti summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--fg);
  }
  .ti summary::-webkit-details-marker {
    display: none;
  }
  .ti summary svg {
    color: var(--fg-3);
    transition: transform 200ms var(--ease-out);
  }
  .ti[open] summary svg {
    transform: rotate(180deg);
  }
  .ti dl {
    display: grid;
    gap: 24px;
    margin: 8px 0 0;
  }
  @media (min-width: 880px) {
    .ti dl {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 32px;
    }
  }
  .ti dt {
    margin-bottom: 6px;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .ti dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-2);
  }
  .blocker {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    margin: 24px 0 8px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-2);
  }
  .blocker strong {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    line-height: 1;
    color: var(--warn);
  }
  @media (prefers-reduced-motion: reduce) {
    .ti summary svg {
      transition: none;
    }
  }
</style>
