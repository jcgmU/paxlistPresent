---
// Ruta acordada para la presentación. La sincronización P2P en vuelo (fases 2 y 3 de ARQUITECTURA_V3.md) queda como módulo opcional después del piloto.
const phases = [
  {
    key: 'hoy',
    name: 'Hecho',
    state: 'Construido',
    weeks: null as number | null,
    span: 'Disponible hoy',
    text: 'App interactiva con datos de demostración: mapa, lentes, lealtad, NPS y comandas.',
    flags: [] as string[],
  },
  {
    key: 'f0',
    name: 'Fase 0 · Descubrimiento',
    state: 'Siguiente',
    weeks: 2,
    span: '2 semanas',
    text: 'Origen del manifiesto, IdP con mTLS, roster e infraestructura, y la sesión con Legal para la DPIA.',
    flags: ['A1', 'A6', 'A8', 'A9', 'A7'],
  },
  {
    key: 'f1',
    name: 'Fase 1 · Backend y sincronización en tierra',
    state: 'Diseñado',
    weeks: 5,
    span: '5 semanas',
    text: 'BFF en NestJS con PostgreSQL, Delta Sync, sincronización en tierra, SQLite con Outbox en el iPad, y el portal de catering en paralelo (3 semanas).',
    flags: [],
  },
  {
    key: 'f2',
    name: 'Fase 2 · Seguridad y QA',
    state: 'Diseñado',
    weeks: 3.5,
    span: '3 a 4 semanas, se solapa con la Fase 1',
    text: 'SQLCipher con Keychain, mTLS con pinning, y pruebas en iPads reales.',
    flags: [],
  },
  {
    key: 'f3',
    name: 'Fase 3 · Piloto BOG–MAD',
    state: 'Condicionado',
    weeks: 2,
    span: '2 semanas',
    text: 'Arranca solo con la DPIA aprobada: una ruta, una tripulación y métricas reales.',
    flags: ['A7'],
  },
  {
    key: 'p2p',
    name: 'Después del piloto · P2P en vuelo',
    state: 'Opcional',
    weeks: null,
    span: 'Módulo evolutivo',
    text: 'Sincronización entre iPads durante el vuelo con Multipeer, relojes HLC y CRDT, según ARQUITECTURA_V3.md. Depende de la red del avión (A4 y A5).',
    flags: ['A4', 'A5'],
  },
];

const blockers = [
  { id: 'A1', t: 'Cómo llega el manifiesto', d: 'API del DCS de Amadeus o mensajes PNL/ADL vía SITA. Sin esto no hay adaptador ni estimación firme de la Fase 1.' },
  { id: 'A6', t: 'Identidad y dispositivos', d: 'Confirmar el IdP corporativo y que los certificados del MDM sirvan para mTLS. Toda la capa de acceso depende de esto.' },
  { id: 'A7', t: 'Legal y DPIA', d: 'Sesión con Legal y el DPO sobre bases legales y retención, y DPIA de la ruta BOG–MAD. Es el gate del piloto.' },
];
const maxWeeks = 6;
---

<section class="road" aria-labelledby="road-title">
  <div class="wrap">
    <header>
      <h2 id="road-title">Hoy es una demo funcional. Esto es lo que falta para volarla.</h2>
      <p class="lead">
        Las fases de seguridad y desarrollo se solapan, y la fecha del piloto depende de los bloqueantes. Las barras comparan duración, no calendario.
      </p>
    </header>

    <ol class="phases">
      {
        phases.map((p) => (
          <li class:list={['phase', `s-${p.key}`]}>
            <div class="head">
              <h3>{p.name}</h3>
              <span class:list={['status', { 'status-ok': p.state === 'Construido', 'status-warn': p.state === 'Condicionado' }]}>{p.state}</span>
            </div>
            <p class="text">{p.text}</p>
            <div class="meter">
              {p.key === 'hoy' || p.key === 'p2p' ? null : p.weeks !== null ? (
                <span class="bar" style={`width:${(p.weeks / maxWeeks) * 100}%`} aria-hidden="true" />
              ) : (
                <span class="bar bar-flex" aria-hidden="true" />
              )}
              <span class="span">{p.span}</span>
            </div>
            {p.flags.length > 0 && (
              <p class="flags">
                Depende de <strong>{p.flags.join(', ')}</strong>
              </p>
            )}
          </li>
        ))
      }
    </ol>

    <div class="blockers">
      <h3>Bloqueantes externos</h3>
      <dl>
        {
          blockers.map((b) => (
            <div>
              <dt>
                <span class="code">{b.id}</span>
                <span class="name">{b.t}</span>
              </dt>
              <dd>{b.d}</dd>
            </div>
          ))
        }
      </dl>
      <p class="foot">Resueltos A1 y A6 en la Fase 0, el resto es ejecutable tal como está planteado.</p>
    </div>
  </div>
</section>

<style>
  .road {
    padding: clamp(80px, 14vh, 160px) 16px;
    background: var(--ink);
    color: var(--fg);
  }
  .wrap {
    margin: 0 auto;
    max-width: 1100px;
  }
  header {
    margin-bottom: 56px;
    max-width: 760px;
  }
  .eyebrow {
    margin: 0 0 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  h2 {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-size: clamp(30px, 4.2vw, 56px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .lead {
    margin: 0;
    max-width: 60ch;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.55;
    color: var(--fg-2);
  }
  .phases {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .phase {
    display: grid;
    gap: 8px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 880px) {
    .phase {
      grid-template-columns: 280px minmax(0, 1fr) 260px;
      gap: 8px 40px;
      align-items: start;
    }
    .phase .flags {
      grid-column: 2 / 4;
    }
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .state {
    padding: 2px 10px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-2);
    white-space: nowrap;
  }
  .state.ok {
    border-color: var(--ok);
    color: var(--ok);
  }
  .state.soft {
    border-style: dashed;
  }
  .state.next {
    border-color: var(--warn);
    color: var(--warn);
  }
  .text {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--fg-2);
  }
  .meter {
    display: grid;
    gap: 6px;
  }
  .bar {
    display: block;
    height: 6px;
    border-radius: 999px;
    background: var(--fg);
  }
  .bar-flex {
    width: 100%;
    height: 6px;
    border: 1px dashed var(--fg-3);
    background: transparent;
  }
  .span {
    font-size: 13px;
    font-weight: 600;
    color: var(--fg-2);
    font-variant-numeric: tabular-nums;
  }
  .flags {
    margin: 0;
    font-size: 13px;
    color: var(--fg-3);
  }
  .flags strong {
    font-weight: 600;
    color: var(--warn);
  }

  .blockers {
    margin-top: 80px;
  }
  .blockers h3 {
    margin-bottom: 8px;
    font-size: 24px;
  }
  .blockers dl {
    margin: 0;
  }
  .blockers dl > div {
    display: grid;
    gap: 6px 40px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 880px) {
    .blockers dl > div {
      grid-template-columns: 320px minmax(0, 1fr);
      align-items: baseline;
    }
  }
  .blockers dt {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .code {
    min-width: 2.2em;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--warn);
  }
  .name {
    font-size: 17px;
    font-weight: 600;
  }
  .blockers dd {
    margin: 0;
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.55;
    color: var(--fg-2);
  }
  .foot {
    margin: 24px 0 0;
    font-size: 14px;
    color: var(--fg-3);
  }
</style>
